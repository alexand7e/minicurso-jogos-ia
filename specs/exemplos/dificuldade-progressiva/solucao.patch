diff --git a/config.gd b/config.gd
index 50c0d03..8fc0faf 100644
--- a/config.gd
+++ b/config.gd
@@ -24,6 +24,8 @@ const PLAYER_SPEED := 400.0           # pixels por segundo
 const MOB_MIN_SPEED := 150.0          # pixels por segundo
 const MOB_MAX_SPEED := 250.0          # precisa ser maior ou igual ao mínimo
 const MOB_SPAWN_INTERVAL := 0.5       # segundos entre um inimigo e o próximo
+const MOB_SPEED_GAIN_PER_POINT := 2.0 # aumento de velocidade por ponto (0 desliga a dificuldade progressiva)
+const MOB_SPEED_CAP := 600.0          # nenhum inimigo passa desta velocidade
 
 # --- Ritmo e pontuação ---
 const START_DELAY := 2.0              # segundos entre "Preparar" e o início da partida
diff --git a/main.gd b/main.gd
index 67cc29f..7b718b5 100644
--- a/main.gd
+++ b/main.gd
@@ -46,14 +46,24 @@ func _on_MobTimer_timeout():
 	direction += randf_range(-PI / 4, PI / 4)
 	mob.rotation = direction
 
-	# Choose the velocity for the mob.
-	var velocity = Vector2(randf_range(Config.MOB_MIN_SPEED, Config.MOB_MAX_SPEED), 0.0)
+	# Choose the velocity for the mob (faixa cresce com a pontuação).
+	var speed_range = mob_speed_range(score)
+	var velocity = Vector2(randf_range(speed_range.x, speed_range.y), 0.0)
 	mob.linear_velocity = velocity.rotated(direction)
 
 	# Spawn the mob by adding it to the Main scene.
 	add_child(mob)
 
 
+# Faixa de velocidade (mínima, máxima) dos inimigos para uma pontuação.
+# Cada ponto soma MOB_SPEED_GAIN_PER_POINT, limitado por MOB_SPEED_CAP.
+func mob_speed_range(points: int) -> Vector2:
+	var gain = points * Config.MOB_SPEED_GAIN_PER_POINT
+	var low = minf(Config.MOB_MIN_SPEED + gain, Config.MOB_SPEED_CAP)
+	var high = minf(Config.MOB_MAX_SPEED + gain, Config.MOB_SPEED_CAP)
+	return Vector2(low, high)
+
+
 func _on_ScoreTimer_timeout():
 	score += Config.SCORE_PER_SECOND
 	$HUD.update_score(score)
